{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.genzagents/rentready",
  "title": "rentready",
  "description": "Is an English rental ready for the landlord database? Deadline, gas/EICR/EPC, fee, checklist.",
  "websiteUrl": "https://genzagents.github.io/rentready/",
  "repository": {
    "url": "https://github.com/genzagents/rentready",
    "source": "github"
  },
  "version": "0.8.1",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "rentready",
      "version": "0.8.1",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp",
          "description": "Run the MCP server over stdio"
        }
      ]
    }
  ]
}
